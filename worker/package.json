{
  "name": "nfl-missed-kick-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that stores the ESPN NFL slate in KV and wakes poll.yml only when games are in a live window.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "dry-run": "tsx src/dry-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.40.0"
  }
}
