# --- X / Twitter (OAuth 1.0a user context) ---
# Create a dedicated bot account, then a Project + App at https://developer.x.com
# App permissions must include "Read and write". Generate user-access tokens for the bot.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Bot behavior ---
# Default true: log tweets instead of posting. Set false only when credentials are in place.
DRY_RUN=true

# Poll interval for `npm start` (milliseconds)
POLL_INTERVAL_MS=30000

# Local handled-plays list (STATE_BACKEND=file). A missing file blocks posting until
# you run `npm run once -- --bootstrap-state`. Season miss tallies are cached beside it
# as tallies.json and rebuilt from ESPN if missing.
STATE_PATH=.state/seen.json

# poll.yml uses STATE_BACKEND=github: handled plays live in STATE_FILE on STATE_BRANCH,
# written with the workflow's GITHUB_TOKEN (contents: write). No extra secret.
# STATE_BACKEND=file
# STATE_BRANCH=bot-state
# STATE_FILE=handled-plays.json

# How long after kickoff to keep fetching a finished game (minutes).
# 4h typical game + this window, so late misses still get picked up.
RECENT_FINAL_WINDOW_MIN=45

# On first deploy, set true once so existing misses are recorded but not tweeted.
SEED_SEEN=false

# Optional override if ESPN starts blocking the default User-Agent
# ESPN_USER_AGENT=Mozilla/5.0 ...
