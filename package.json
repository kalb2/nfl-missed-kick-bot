{
  "name": "nfl-missed-kick-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Tweets whenever an NFL kicker misses a field goal or PAT, using ESPN's public play-by-play.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts loop",
    "once": "tsx src/index.ts once",
    "dry-run": "tsx src/index.ts dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "twitter-api-v2": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
